from pathlib import Path
import csv
import shutil
import subprocess
import sys

HERE = Path(workflow.basedir).resolve()
REPO_ROOT = HERE.parents[1]
WORK = HERE / "work"
PROJECT = WORK / "irma" / "project"
SEGMENT_SEQUENCE = ("HA", "NA", "PB2", "PB1", "PA", "NP", "MP", "NS")


checkpoint normalize_irma_outputs:
    input:
        project=PROJECT,
        normalizer=str(REPO_ROOT / "scripts" / "normalize_irma_outputs.py")
    output:
        segments=directory(WORK / "irma" / "segments"),
        manifest=WORK / "irma" / "manifest.tsv"
    log:
        WORK / "irma" / "normalize.log"
    conda:
        "../../envs/pysam.yaml"
    run:
        project_path = Path(str(input.project)).resolve()
        normalizer_path = Path(str(input.normalizer)).resolve()
        segments_path = Path(str(output.segments)).resolve()
        manifest_path = Path(str(output.manifest)).resolve()
        log_path = Path(str(log[0])).resolve()

        segments_path.parent.mkdir(parents=True, exist_ok=True)
        manifest_path.parent.mkdir(parents=True, exist_ok=True)
        log_path.parent.mkdir(parents=True, exist_ok=True)

        if segments_path.exists():
            shutil.rmtree(segments_path)
        if manifest_path.exists():
            manifest_path.unlink()

        command = [
            sys.executable,
            str(normalizer_path),
            "--project", str(project_path),
            "--segments", str(segments_path),
            "--manifest", str(manifest_path),
            "--sample", "checkpoint_smoke",
        ]

        with log_path.open("w") as log_handle:
            log_handle.write("Normalization command: " + " ".join(command) + "\n")
            log_handle.flush()
            subprocess.run(
                command,
                check=True,
                stdout=log_handle,
                stderr=subprocess.STDOUT,
            )

        if not manifest_path.is_file() or manifest_path.stat().st_size == 0:
            raise RuntimeError("Normalizer did not create a non-empty manifest")

        with manifest_path.open(encoding="utf-8") as handle:
            reader = csv.DictReader(handle, delimiter="\t")
            rows = list(reader)

        ready = sorted(
            {
                row["segment"]
                for row in rows
                if row.get("status") == "READY"
                and row.get("segment") in SEGMENT_SEQUENCE
            },
            key=SEGMENT_SEQUENCE.index,
        )

        with log_path.open("a") as log_handle:
            log_handle.write("\nESCAPE_STATUS=IRMA_NORMALIZATION_COMPLETED\n")
            log_handle.write(f"ESCAPE_READY_SEGMENT_COUNT={len(ready)}\n")
            log_handle.write(
                "ESCAPE_READY_SEGMENTS="
                + (",".join(ready) if ready else "NONE")
                + "\n"
            )


def normalized_manifest(_wildcards):
    return str(
        checkpoints.normalize_irma_outputs.get().output.manifest
    )


def normalized_segments_dir(_wildcards):
    return Path(
        str(checkpoints.normalize_irma_outputs.get().output.segments)
    )


def ready_segment_files(wildcards):
    manifest = Path(normalized_manifest(wildcards))
    segments_dir = normalized_segments_dir(wildcards)

    with manifest.open(encoding="utf-8") as handle:
        rows = list(csv.DictReader(handle, delimiter="\t"))

    files = []
    for row in rows:
        segment = row.get("segment", "")
        if row.get("status") != "READY":
            continue
        if segment not in SEGMENT_SEQUENCE:
            continue

        fasta = segments_dir / segment / "consensus.fasta"
        bam = segments_dir / segment / "alignment.bam"
        if fasta.is_file() and fasta.stat().st_size > 0 and bam.is_file() and bam.stat().st_size > 0:
            files.extend([str(fasta), str(bam)])

    return files


rule checkpoint_downstream:
    input:
        manifest=normalized_manifest,
        ready_files=ready_segment_files
    output:
        tsv=WORK / "downstream" / "ready_segments.tsv"
    run:
        manifest_path = Path(str(input.manifest))
        with manifest_path.open(encoding="utf-8") as handle:
            rows = list(csv.DictReader(handle, delimiter="\t"))

        ready = [
            row["segment"]
            for row in rows
            if row.get("status") == "READY"
        ]

        output_path = Path(str(output.tsv))
        output_path.parent.mkdir(parents=True, exist_ok=True)
        output_path.write_text(
            "segment\n" + "\n".join(ready) + ("\n" if ready else ""),
            encoding="utf-8",
        )


rule all:
    input:
        WORK / "downstream" / "ready_segments.tsv"
